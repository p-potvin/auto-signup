{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": ["chrome"],
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"],
    // The service worker has its own config — see tsconfig.sw.json.
    "exclude": ["node_modules", "dist", "src-legacy", "src/mobile/service-worker.ts"]
}
